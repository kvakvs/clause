{application, syntax_tools, [
    {description, "Syntax tools"},
    {vsn, "4.1.1"},
    {modules, [clause_prettypr, erl_prettypr, erl_syntax, prettypr]},
    {registered, []},
    {applications, [stdlib]},
    {env, []},
    {runtime_dependencies, ["compiler-9.0", "erts-16.0", "kernel-10.3", "stdlib-8.0"]}
]}.
