    RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT result STREQUAL "0" OR NOT err STREQUAL "")
    message(FATAL_ERROR "Syntax-only action performed semantic validation")
endif()
execute_process(COMMAND "${TOOL}" missing.erl undefined_export.erl WORKING_DIRECTORY "${semantic_work}"
    RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT result STREQUAL "1" OR NOT err MATCHES "missing module.*undefined function")
    message(FATAL_ERROR "Semantic failure prevented later-file diagnostics: ${err}")
endif()
