#!/usr/bin/env escript
%% Generates runtime/src/builtins/front_end/otp_obsolete.inc (plan 21 step LIB34C): the clauses of OTP's
%% otp_internal:obsolete/3, obsolete_type/3 and obsolete_callback/3 as C++ rows, read from the pinned checkout.
%% Usage: escript generate_obsolete.escript references/otp/lib/stdlib/src/otp_internal.erl Output.inc
-mode(compile).

main([Source, Output]) ->
    {ok, Forms} = epp:parse_file(Source, [{includes, [filename:dirname(Source)]}]),
    Rows = lists:append([rows(Name, Clauses) || {function, _, Name, 3, Clauses} <- Forms]),
    Header = [
        "// Generated by tests/compiler/library/generate_obsolete.escript from OTP's otp_internal.erl; do not edit.\n",
        "// {Table, Module, Function, Arity, Tag, Info, Release}: \"\" and -1 match any function and arity, Info \"\" is the\n",
        "// atom of InfoAtom, Release \"\" none.\n"
    ],
    ok = file:write_file(Output, [Header | Rows]).

rows(Name, Clauses) when Name =:= obsolete; Name =:= obsolete_type; Name =:= obsolete_callback ->
    [row(Name, Clause) || Clause <- Clauses, not is_default(Clause)];
rows(_, _) ->
    [].

is_default({clause, _, [{var, _, _}, {var, _, _}, {var, _, _}], [], [{atom, _, no}]}) -> true;
is_default(_) -> false.

row(Table, {clause, _, [M, F, A], [], [Body]}) ->
    {Tag, Info, Release} =
        case erl_parse:normalise(Body) of
            {T, I} -> {T, I, ""};
            {T, I, R} -> {T, I, R}
        end,
    {InfoText, InfoAtom} =
        case is_atom(Info) of
            true -> {"", atom_to_list(Info)};
            false -> {Info, ""}
        end,
    io_lib:format("    ObsoleteRow{\"~s\", \"~s\", \"~s\", ~s, \"~s\", ~s, \"~s\", ~s},\n", [
        Table, value(M), value(F), arity(A), Tag, literal(InfoText), InfoAtom, literal(Release)
    ]).

value({atom, _, Atom}) -> atom_to_list(Atom);
value({var, _, _}) -> "".

arity({integer, _, N}) -> integer_to_list(N);
arity({var, _, _}) -> "-1".

%% A C++ string literal of a character list (UTF-8).
literal(Text) ->
    Bytes = unicode:characters_to_binary(Text),
    [$" | lists:append([escape(B) || <<B>> <= Bytes])] ++ [$"].

escape($") -> "\\\"";
escape($\\) -> "\\\\";
escape(B) when B >= 32, B < 127 -> [B];
escape(B) -> io_lib:format("\\~3.8.0b", [B]).
