# PCRE2 for the runtime's re builtins (plan step 41ZA, docs/compile.md#pcre2): the release OTP 29 bundles, 8-bit
# code units, Unicode support, no JIT. Resolution order: CLAUSE_PCRE2_ROOT (a source directory), an installed
# PCRE2 of at least that version (CMake package, then pkg-config), then the pinned release downloaded into
# thirdparty/. clause_add_pcre2(target) gives `target` the library: source builds add their objects to it, so the
# runtime archive carries PCRE2 itself; an installed library is recorded for the executables clau links.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ThirdPartyDependencies.cmake")

set(CLAUSE_PCRE2_VERSION 10.47)
set(CLAUSE_PCRE2_ROOT "" CACHE PATH "PCRE2 ${CLAUSE_PCRE2_VERSION} source directory; takes precedence over installed and downloaded copies")
option(CLAUSE_DOWNLOAD_PCRE2 "Download PCRE2 ${CLAUSE_PCRE2_VERSION} into thirdparty when no source directory or installed copy is found" ON)
option(CLAUSE_PCRE2_SYSTEM "Use an installed PCRE2 when CLAUSE_PCRE2_ROOT is not set" ON)

# The library sources of one release (its CMakeLists.txt PCRE2_SOURCES, without the generated character tables).
set(CLAUSE_PCRE2_SOURCES auto_possess chkdint compile compile_cgroup compile_class config context convert dfa_match
    error extuni find_bracket jit_compile maketables match match_data match_next newline ord2utf pattern_info
    script_run serialize string_utils study substitute substring tables ucd valid_utf xclass)

# The checked version of a PCRE2 source directory from its configure.ac.
function(clause_pcre2_source_version source output)
    file(STRINGS "${source}/configure.ac" lines REGEX "^m4_define\\(pcre2_(major|minor),")
    string(REGEX MATCH "pcre2_major, *\\[([0-9]+)\\]" major "${lines}")
    set(major "${CMAKE_MATCH_1}")
    string(REGEX MATCH "pcre2_minor, *\\[([0-9]+)\\]" minor "${lines}")
    set(${output} "${major}.${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

# clause_pcre2: the library's objects from `source`, built without the project's warning flags, with the
# distributed config.h, pcre2.h and character tables copied into the build tree (no generation step).
function(clause_pcre2_from_source source)
    clause_pcre2_source_version("${source}" version)
    if(NOT version STREQUAL CLAUSE_PCRE2_VERSION)
        message(FATAL_ERROR "Expected PCRE2 ${CLAUSE_PCRE2_VERSION} under ${source}, found ${version}")
    endif()
    set(generated "${CMAKE_BINARY_DIR}/pcre2")
    configure_file("${source}/src/config.h.generic" "${generated}/config.h" COPYONLY)
    configure_file("${source}/src/pcre2.h.generic" "${generated}/pcre2.h" COPYONLY)
    configure_file("${source}/src/pcre2_chartables.c.dist" "${generated}/pcre2_chartables.c" COPYONLY)
    set(files "${generated}/pcre2_chartables.c")
    foreach(name IN LISTS CLAUSE_PCRE2_SOURCES)
        list(APPEND files "${source}/src/pcre2_${name}.c")
    endforeach()
    add_library(clause_pcre2 OBJECT ${files})
    target_include_directories(clause_pcre2 SYSTEM PUBLIC "${generated}" PRIVATE "${source}/src")
    target_compile_definitions(clause_pcre2 PUBLIC PCRE2_CODE_UNIT_WIDTH=8 PCRE2_STATIC
        PRIVATE HAVE_CONFIG_H SUPPORT_UNICODE)
    set_target_properties(clause_pcre2 PROPERTIES POSITION_INDEPENDENT_CODE ON)
    if(MSVC)
        target_compile_options(clause_pcre2 PRIVATE /W0)
    else()
        target_compile_options(clause_pcre2 PRIVATE -w)
    endif()
    message(STATUS "PCRE2 ${CLAUSE_PCRE2_VERSION} from source: ${source}")
endfunction()

# An installed PCRE2 of at least the pinned version, preferring a static archive: sets clause_pcre2_library,
# clause_pcre2_include and clause_pcre2_static in the caller, or leaves them empty.
function(clause_find_installed_pcre2)
    set(PCRE2_USE_STATIC_LIBS ON)
    find_package(pcre2 ${CLAUSE_PCRE2_VERSION} CONFIG QUIET COMPONENTS 8BIT)
    if(TARGET PCRE2::8BIT)
        get_target_property(type PCRE2::8BIT TYPE)
        get_target_property(include PCRE2::8BIT INTERFACE_INCLUDE_DIRECTORIES)
        foreach(property IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION IMPORTED_LOCATION_NOCONFIG)
            get_target_property(library PCRE2::8BIT ${property})
            if(library)
                break()
            endif()
        endforeach()
        set(static OFF)
        if(type STREQUAL "STATIC_LIBRARY")
            set(static ON)
        endif()
    else()
        find_package(PkgConfig QUIET)
        if(PKG_CONFIG_FOUND)
            pkg_check_modules(clause_installed_pcre2 QUIET libpcre2-8>=${CLAUSE_PCRE2_VERSION})
        endif()
        if(NOT clause_installed_pcre2_FOUND)
            return()
        endif()
        set(include "${clause_installed_pcre2_INCLUDE_DIRS}")
        find_library(clause_pcre2_archive NAMES libpcre2-8.a pcre2-8-static
            HINTS ${clause_installed_pcre2_LIBRARY_DIRS} NO_DEFAULT_PATH)
        if(clause_pcre2_archive)
            set(library "${clause_pcre2_archive}")
            set(static ON)
        else()
            find_library(clause_pcre2_shared NAMES pcre2-8 HINTS ${clause_installed_pcre2_LIBRARY_DIRS})
            set(library "${clause_pcre2_shared}")
            set(static OFF)
        endif()
    endif()
    if(library)
        set(clause_pcre2_library "${library}" PARENT_SCOPE)
        set(clause_pcre2_include "${include}" PARENT_SCOPE)
        set(clause_pcre2_static "${static}" PARENT_SCOPE)
    endif()
endfunction()

# Give `target` PCRE2 and record what clau must add to link an executable with it.
function(clause_add_pcre2 target)
    if(NOT CLAUSE_PCRE2_ROOT AND CLAUSE_PCRE2_SYSTEM)
        clause_find_installed_pcre2()
    endif()
    if(clause_pcre2_library)
        target_include_directories(${target} SYSTEM PRIVATE ${clause_pcre2_include})
        target_compile_definitions(${target} PRIVATE PCRE2_CODE_UNIT_WIDTH=8 $<$<BOOL:${clause_pcre2_static}>:PCRE2_STATIC>)
        target_link_libraries(${target} PUBLIC "${clause_pcre2_library}")
        set_property(TARGET ${target} APPEND PROPERTY CLAUSE_LINK_ARGUMENTS "${clause_pcre2_library}")
        if(clause_pcre2_static)
            message(STATUS "PCRE2: installed static library ${clause_pcre2_library}")
        else()
            message(STATUS "PCRE2: installed shared library ${clause_pcre2_library}; executables need it at run time")
        endif()
        return()
    endif()
    if(CLAUSE_PCRE2_ROOT)
        set(source "${CLAUSE_PCRE2_ROOT}")
    elseif(CLAUSE_DOWNLOAD_PCRE2)
        clause_download_dependency(pcre2-${CLAUSE_PCRE2_VERSION}
            "https://github.com/PCRE2Project/pcre2/releases/download/pcre2-${CLAUSE_PCRE2_VERSION}/pcre2-${CLAUSE_PCRE2_VERSION}.tar.bz2"
            "47fe8c99461250d42f89e6e8fdaeba9da057855d06eb7fc08d9ca03fd08d7bc7"
            "src/pcre2.h.generic" source)
    else()
        message(FATAL_ERROR "PCRE2 ${CLAUSE_PCRE2_VERSION} is required: set CLAUSE_PCRE2_ROOT to its source directory, install it, or enable CLAUSE_DOWNLOAD_PCRE2 (docs/compile.md#pcre2).")
    endif()
    if(NOT TARGET clause_pcre2)
        clause_pcre2_from_source("${source}")
    endif()
    target_sources(${target} PRIVATE $<TARGET_OBJECTS:clause_pcre2>)
    target_include_directories(${target} SYSTEM PRIVATE $<TARGET_PROPERTY:clause_pcre2,INTERFACE_INCLUDE_DIRECTORIES>)
    target_compile_definitions(${target} PRIVATE $<TARGET_PROPERTY:clause_pcre2,INTERFACE_COMPILE_DEFINITIONS>)
endfunction()
